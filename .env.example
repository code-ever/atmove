# ---- core ----
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/atm-enugu
TRUST_PROXY=1
# ALLOWED_ORIGINS=https://atmenugu.org,https://www.atmenugu.org
# COOKIE_SECURE=auto            # auto | always | never

# ---- first administrator (optional; or use scripts/create-admin.js). Remove the password after first start. ----
# ADMIN_NAME=Full Name
# ADMIN_PHONE=080XXXXXXXX
# ADMIN_EMAIL=you@example.ng
# ADMIN_PASSWORD=

# ---- SMS / WhatsApp via Termii ----
SMS_PROVIDER=termii             # console prints codes to the log instead (development only)
TERMII_API_KEY=
TERMII_SENDER_ID=ATM

# ---- email via Resend (optional) ----
EMAIL_PROVIDER=console          # resend
RESEND_API_KEY=
MAIL_FROM=ATM Enugu <no-reply@your-domain.ng>

# ---- uploads ----
# SCAN_CMD=clamscan
# SCAN_ARGS=--no-summary

# ---- backups ----
BACKUP_DIR=/var/backups/atm-enugu
BACKUP_KEY=change-this-to-a-long-random-passphrase
BACKUP_KEEP=14

# ---- misc ----
PRIVACY_VERSION=2026-v1
# RATE_API_PER_MIN=600
# SKIP_PLACEHOLDERS=1            # start with no demo wards/PUs (import the INEC directory first)
